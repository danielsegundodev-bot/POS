generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  role         String   @default("cashier")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  sales        Sale[]
}

model Category {
  id       String     @id @default(cuid())
  name     String     @unique
  color    String?
  products Product[]
}

model Product {
  id          String    @id @default(cuid())
  sku         String    @unique
  name        String
  description String?
  categoryId  String?
  category    Category? @relation(fields: [categoryId], references: [id])
  /** Precio en centavos (unidad mínima). */
  price       Int       @default(0)
  /** Fracción impositiva: 0.16 = 16 %. */
  taxRate     Float     @default(0)
  trackStock  Boolean   @default(false)
  stock       Int       @default(0)
  active      Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  movements   StockMovement[]
  saleLines   SaleLine[]

  @@index([categoryId])
}

model StockMovement {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id])
  /** in = entrada, out = salida, adjustment = ajuste a valor absoluto. */
  type      String
  /** Cantidad: positiva para in/out; valor absoluto para adjustment. */
  quantity  Int
  reason    String?
  createdAt DateTime @default(now())

  @@index([productId])
  @@index([createdAt])
}

model Sale {
  id              String     @id @default(cuid())
  /** Folio legible del ticket, p. ej. "T-000123". */
  folio           String     @unique
  /** Credito en centavos. */
  subtotal        Int
  /** Impuesto total en centavos. */
  tax             Int
  /** Descuento total en centavos. */
  discount        Int        @default(0)
  /** Total a pagar en centavos. */
  total           Int
  /** cash | card | transfer | other */
  paymentMethod   String
  /** Importe recibido en efectivo (centavos); solo para cash. */
  paymentReceived Int?
  /** Cambio entregado en centavos; solo para cash. */
  paymentChange   Int?
  userId          String?
  user            User?      @relation(fields: [userId], references: [id])
  customerId      String?
  customer        Customer?  @relation(fields: [customerId], references: [id])
  lines           SaleLine[]
  createdAt       DateTime   @default(now())

  @@index([createdAt])
  @@index([customerId])
}

model Customer {
  id        String   @id @default(cuid())
  name      String
  email     String?
  phone     String?
  /** RFC / NIF / identificación fiscal. */
  taxId     String?
  address   String?
  notes     String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  sales     Sale[]

  @@index([name])
}

model SaleLine {
  id         String  @id @default(cuid())
  saleId     String
  sale       Sale    @relation(fields: [saleId], references: [id], onDelete: Cascade)
  productId  String
  product    Product @relation(fields: [productId], references: [id])
  /** Nombre del producto al momento de la venta (snapshot). */
  productName String
  quantity   Int
  /** Precio unitario en centavos (snapshot). */
  unitPrice  Int
  /** Descuento total de la línea en centavos. */
  discount   Int     @default(0)
  /** Fracción impositiva al momento de la venta (snapshot). */
  taxRate    Float
  subtotal   Int
  tax        Int
  total      Int

  @@index([saleId])
  @@index([productId])
}
