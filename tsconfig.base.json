{
  "compileOnSave": false,
  "compilerOptions": {
    "rootDir": ".",
    "sourceMap": true,
    "declaration": false,
    "experimentalDecorators": true,
    "importHelpers": true,
    "module": "preserve",
    "moduleResolution": "bundler",
    "target": "es2022",
    "lib": ["es2022", "dom"],
    "skipLibCheck": true,
    "strict": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "noUnusedLocals": true,
    "noUncheckedSideEffectImports": false,
    "paths": {
      "@pos/ui-atoms": ["./libs/ui_atoms/src/index.ts"],
      "@pos/ui-molecules": ["./libs/ui_molecules/src/index.ts"],
      "@pos/ui-organisms": ["./libs/ui_organisms/src/index.ts"],
      "@pos/shell": ["./libs/shell/src/index.ts"],
      "@pos/data-access": ["./libs/data_access/src/index.ts"],
      "@pos/core": ["./libs/core/src/index.ts"],
      "@pos/features/auth": ["./libs/features/auth/src/index.ts"],
      "@pos/features/products": ["./libs/features/products/src/index.ts"],
      "@pos/features/inventory": ["./libs/features/inventory/src/index.ts"]
    }
  },
  "exclude": ["node_modules", "tmp"]
}
